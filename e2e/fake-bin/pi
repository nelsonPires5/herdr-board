#!/usr/bin/env bash
# Hermetic, no-provider Pi stand-in for protocol-20 managed launches.
# It validates the authoritative startup-only system-prompt file, rejects card
# prompt material in argv, reports through HERDR_PANE_ID, and then blocks on its
# interactive tty until Herdr's agent.prompt delivers the card task on stdin.
set -euo pipefail

if [ "${FAKE_PI_EXTERNAL:-0}" = "1" ]; then
  : "${HERDR_PANE_ID:?HERDR_PANE_ID required}"
  : "${HERDR_SOCKET_PATH:?HERDR_SOCKET_PATH required}"
  session_path="$(dirname "$HERDR_SOCKET_PATH")/external-pi-$$.jsonl"
  printf '{"type":"session","id":"external-%s"}\n' "$$" >"$session_path"
  chmod 600 "$session_path"
  printf '\033]0;π - external\007\n /help\n\n──────────────────────────────────────────────────────\n%s\n' "$PWD"
  python3 - "$HERDR_SOCKET_PATH" "$HERDR_PANE_ID" "$session_path" <<'PY'
import json, os, socket, sys, time
socket_path, pane_id, session_path = sys.argv[1:]
request = {
    "id": f"external-pi:{os.getpid()}",
    "method": "pane.report_agent",
    "params": {
        "pane_id": pane_id,
        "source": "herdr:pi",
        "agent": "pi",
        "agent_session_path": session_path,
        "session_start_source": "startup",
        "state": "idle",
        "seq": time.time_ns(),
    },
}
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
    client.settimeout(2)
    client.connect(socket_path)
    client.sendall((json.dumps(request, separators=(",", ":")) + "\n").encode())
    reply = client.recv(65536)
if b'"error"' in reply or b'"result"' not in reply:
    raise SystemExit(f"external Pi report failed: {reply!r}")
PY
  sleep "${FAKE_PI_SLEEP:-300}"
  exit 0
fi

: "${BOARD_CARD_ID:?BOARD_CARD_ID required}"
: "${BOARD_SOCKET:?BOARD_SOCKET required}"
: "${HERDR_SOCKET_PATH:?HERDR_SOCKET_PATH required}"

# A *rescued* pane resumes an already-finished run, so the daemon deliberately
# withholds BOARD_RUN_ID: that variable is the actor credential for
# `board comment`/`done`, and a rescued pane must not be able to write to the
# immutable historical run row. The run id arrives as the inert
# BOARD_RESCUED_RUN_ID label instead, which is all this fixture needs to name
# its artifacts.
if [ "${BOARD_RESCUE:-0}" = "1" ]; then
  [ -z "${BOARD_RUN_ID:-}" ] \
    || { echo 'fake pi: a rescued pane must NOT receive BOARD_RUN_ID' >&2; exit 2; }
  : "${BOARD_RESCUED_RUN_ID:?BOARD_RESCUED_RUN_ID required on a rescued pane}"
  RUN_LABEL="$BOARD_RESCUED_RUN_ID"
else
  : "${BOARD_RUN_ID:?BOARD_RUN_ID required}"
  RUN_LABEL="$BOARD_RUN_ID"
fi

argv=("$@")
model=""; thinking=""; session_id=""; fork_id=""; system_file=""
while (($#)); do
  case "$1" in
    --model)
      (($# >= 2)) || { echo 'fake pi: --model missing value' >&2; exit 2; }
      model="$2"; shift 2 ;;
    --thinking)
      (($# >= 2)) || { echo 'fake pi: --thinking missing value' >&2; exit 2; }
      thinking="$2"; shift 2 ;;
    --session-id)
      (($# >= 2)) || { echo 'fake pi: --session-id missing value' >&2; exit 2; }
      session_id="$2"; shift 2 ;;
    --fork)
      (($# >= 2)) || { echo 'fake pi: --fork missing value' >&2; exit 2; }
      fork_id="$2"; shift 2 ;;
    --append-system-prompt)
      (($# >= 2)) || { echo 'fake pi: --append-system-prompt missing path' >&2; exit 2; }
      [ -z "$system_file" ] || { echo 'fake pi: duplicate --append-system-prompt' >&2; exit 2; }
      system_file="$2"; shift 2 ;;
    --append-system-prompt-file|--)
      echo "fake pi: invalid protocol-20 startup option: $1" >&2; exit 2 ;;
    -*) echo "fake pi: unexpected startup option: $1" >&2; exit 2 ;;
    *) echo "fake pi: card prompt leaked into startup argv: $1" >&2; exit 2 ;;
  esac
done
[ -n "$session_id" ] || { echo 'fake pi: session id required' >&2; exit 2; }
[ -n "$system_file" ] || { echo 'fake pi: --append-system-prompt PATH required' >&2; exit 2; }
[ -f "$system_file" ] || { echo "fake pi: system-prompt file absent at startup: $system_file" >&2; exit 2; }

# A rescued pane resumes an ALREADY FINISHED run, so its run label repeats the
# original run's. Keep its artifacts on separate paths (and never clobber the
# original run's record) so a scenario can assert both launches independently.
suffix=""
if [ "${BOARD_RESCUE:-0}" = "1" ]; then
  suffix="-rescue"
  [ -n "${BOARD_RESUME_SESSION_ID:-}" ] \
    || { echo 'fake pi: BOARD_RESCUE=1 without BOARD_RESUME_SESSION_ID' >&2; exit 2; }
  [ "$BOARD_RESUME_SESSION_ID" = "$session_id" ] \
    || { echo "fake pi: resume id '$BOARD_RESUME_SESSION_ID' != --session-id '$session_id'" >&2; exit 2; }
fi
record="$(dirname "$BOARD_SOCKET")/fake-pi-run-$RUN_LABEL$suffix.json"
python3 - "$record" "$RUN_LABEL" "$PWD" "$BOARD_CARD_ID" "$BOARD_SOCKET" \
  "$HERDR_SOCKET_PATH" "$model" "$thinking" "$session_id" "$fork_id" \
  "$system_file" "${argv[@]}" <<'PY'
import json, os, stat, sys
(path, run_id, cwd, card_id, board_socket, herdr_socket, model, thinking,
 session_id, fork_id, system_file, *argv) = sys.argv[1:]
metadata = os.stat(system_file)
mode = stat.S_IMODE(metadata.st_mode)
with open(system_file, "r", encoding="utf-8", newline="") as source:
    system_prompt = source.read()
protocol = """## herdr-board protocol
You are running a herdr-board card ($BOARD_CARD_ID is preset). When this stage's goal is met you MUST finish with exactly two commands: first `board comment \"<your results, files touched, findings>\"`, then `board done --outcome ok`. If the stage goal was NOT met — something failed or you got lost — use `board done --outcome fail --summary \"<why>\"` instead. Always comment before done. Never use `board move`/`cancel`/`retry` on your own card. Finishing or going idle WITHOUT `board done` leaves the card in `awaiting` for human review — a run is never auto-completed."""
assert mode == 0o600
assert system_prompt == protocol or system_prompt.endswith("\n\n" + protocol)
with open(path, "w", encoding="utf-8") as target:
    json.dump({
        "run_id": int(run_id), "card_id": int(card_id), "cwd": cwd,
        "board_socket": board_socket, "herdr_socket": herdr_socket,
        "model": model, "thinking": thinking, "session_id": session_id,
        "fork_id": fork_id or None, "argv": argv,
        "slow_provider_env": os.environ.get("FAKE_PI_SLOW_PROVIDER"),
        "system_prompt_file": system_file,
        "system_prompt_exists_at_read": True,
        "system_prompt_mode": mode,
        "system_prompt": system_prompt,
    }, target, ensure_ascii=False, indent=2)
    target.write("\n")
PY

# Mirror the real Pi startup ordering: establish a real, unique transcript
# path, emit Pi's terminal identity/idle surface, report session identity, and
# only then report idle lifecycle state. Herdr must accept this before it sends
# agent.prompt; no fixture path calls board done early.
session_dir="$(dirname "$BOARD_SOCKET")/fake-pi-sessions"
mkdir -p "$session_dir"
# Unique per process: a run can be reopened more than once (each reopen is a
# fresh launch), and the exclusive-create below must keep catching a genuine
# double-launch of the SAME process rather than failing a legitimate retry.
session_path="$session_dir/${session_id}-${RUN_LABEL}${suffix}-$$.jsonl"
python3 - "$session_path" "$session_id" "$RUN_LABEL" <<'PY'
import json, os, sys
path, session_id, run_id = sys.argv[1:]
with open(path, "x", encoding="utf-8") as target:
    json.dump({"type": "session", "id": session_id, "run_id": int(run_id)}, target)
    target.write("\n")
os.chmod(path, 0o600)
PY
printf '\033]0;π - %s\007' "$(basename "$PWD")"
printf '\n /help\n\n──────────────────────────────────────────────────────\n\n──────────────────────────────────────────────────────\n%s\n' "$PWD"
if [ -n "${FAKE_PI_SLOW_PROVIDER:-}" ]; then
  # Issue #98: slow-provider repro — model a Pi still resolving provider credentials
  # when the prompt lands. Real Pi resolves apiKey via shell command and is not
  # yet reading its tty; bytes delivered via agent.prompt before session identity
  # are dropped (raw-mode discard). Deterministic provider-free repro:
  #   1) report idle lifecycle FIRST so Herdr flips interactive_ready/launch_pending,
  #   2) sleep FAKE_PI_SLOW_PROVIDER seconds (window where early prompt would land),
  #   3) drain-and-discard any tty bytes that arrived during the sleep (dropped pre-init input),
  #   4) report session identity (pane.report_agent_session) — the true readiness signal — only then,
  #   5) proceed to the existing prompt shim which now sees only prompts delivered AFTER session.
  # The fixture record must still prove exactly one prompt was received and matched AFTER session.
  python3 - "$record" "$session_path" <<'PY'
import json, os, socket, sys, time
record_path, session_path = sys.argv[1:]
pane_id = os.environ.get("HERDR_PANE_ID", "")
socket_path = os.environ.get("HERDR_SOCKET_PATH", "")
source = "herdr:pi"
seq = time.time_ns()
common = {"pane_id": pane_id, "source": source, "agent": "pi"}
session_ref = {"agent_session_path": session_path}
def _update(path, **fields):
    with open(path, encoding="utf-8") as f:
        r = json.load(f)
    r.update(fields)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as t:
        json.dump(r, t, ensure_ascii=False, indent=2)
        t.write("\n")
    os.replace(tmp, path)
def _request(sock, envelope):
    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    c.settimeout(2.0)
    try:
        c.connect(sock)
        c.sendall((json.dumps(envelope, separators=(",", ":")) + "\n").encode())
        chunks = bytearray()
        while b"\n" not in chunks:
            chunk = c.recv(65536)
            if not chunk:
                break
            chunks.extend(chunk)
    finally:
        c.close()
    line = bytes(chunks).splitlines()[0] if chunks else b""
    if not line:
        raise RuntimeError("Herdr closed the report socket without a reply")
    return json.loads(line)
reports = []
_update(record_path, herdr_pane_id=pane_id, report_socket=socket_path, agent_session_id=None, agent_session_path=session_path, session_start_source="startup", reports=reports, readiness_report="reporting")
params = {**common, **session_ref, "seq": seq, "session_start_source": "startup", "state": "idle"}
envelope = {"id": f"e2e:{source}:{os.getpid()}:0", "method": "pane.report_agent", "params": params}
result = {"phase": "idle_lifecycle", "request": envelope}
try:
    reply = _request(socket_path, envelope)
    result["reply"] = reply
    result["ok"] = "result" in reply and "error" not in reply
except Exception as e:
    result["ok"] = False
    result["error"] = f"{type(e).__name__}: {e}"
reports.append(result)
_update(record_path, reports=reports)
if not result["ok"]:
    _update(record_path, readiness_report="failed:idle_lifecycle")
    print(f"managed-agent-report (slow-provider): idle report failed: {result}", file=sys.stderr)
    sys.exit(2)
PY
  sleep "$FAKE_PI_SLOW_PROVIDER"
  if [ -t 0 ]; then
    # Drain from the REAL tty: `python3 -c` keeps stdin attached to the pane's
    # terminal — a `python3 - <<'PY'` heredoc would redirect stdin to the script
    # pipe and drain nothing, silently breaking the repro.
    python3 -c 'import os, select, fcntl
fd = 0
flags = fcntl.fcntl(fd, fcntl.F_GETFL)
fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
try:
    while True:
        r, _, _ = select.select([fd], [], [], 0)
        if not r:
            break
        try:
            data = os.read(fd, 65536)
        except BlockingIOError:
            break
        if not data:
            break
finally:
    fcntl.fcntl(fd, fcntl.F_SETFL, flags)' || true
  fi
  python3 - "$record" "$session_path" <<'PY'
import json, os, socket, sys, time
record_path, session_path = sys.argv[1:]
pane_id = os.environ.get("HERDR_PANE_ID", "")
socket_path = os.environ.get("HERDR_SOCKET_PATH", "")
source = "herdr:pi"
seq = time.time_ns()
common = {"pane_id": pane_id, "source": source, "agent": "pi"}
session_ref = {"agent_session_path": session_path}
def _update(path, **fields):
    with open(path, encoding="utf-8") as f:
        r = json.load(f)
    r.update(fields)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as t:
        json.dump(r, t, ensure_ascii=False, indent=2)
        t.write("\n")
    os.replace(tmp, path)
def _request(sock, envelope):
    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    c.settimeout(2.0)
    try:
        c.connect(sock)
        c.sendall((json.dumps(envelope, separators=(",", ":")) + "\n").encode())
        chunks = bytearray()
        while b"\n" not in chunks:
            chunk = c.recv(65536)
            if not chunk:
                break
            chunks.extend(chunk)
    finally:
        c.close()
    line = bytes(chunks).splitlines()[0] if chunks else b""
    if not line:
        raise RuntimeError("Herdr closed the report socket without a reply")
    return json.loads(line)
with open(record_path, encoding="utf-8") as f:
    rec = json.load(f)
reports = rec.get("reports", [])
params = {**common, **session_ref, "seq": seq, "session_start_source": "startup"}
envelope = {"id": f"e2e:{source}:{os.getpid()}:1", "method": "pane.report_agent_session", "params": params}
result = {"phase": "session_identity", "request": envelope}
try:
    reply = _request(socket_path, envelope)
    result["reply"] = reply
    result["ok"] = "result" in reply and "error" not in reply
except Exception as e:
    result["ok"] = False
    result["error"] = f"{type(e).__name__}: {e}"
reports.append(result)
_update(record_path, reports=reports)
if not result["ok"]:
    _update(record_path, readiness_report="failed:session_identity")
    print(f"managed-agent-report (slow-provider): session report failed: {result}", file=sys.stderr)
    sys.exit(2)
_update(record_path, readiness_report="ok")
PY
else
  python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/managed-agent-report.py" \
    "$record" pi "" "$session_path" startup
fi

# A rescued pane resumes an existing conversation, so the daemon deliberately
# sends NO agent.prompt (re-sending the card task would re-run it). Skip the
# prompt shim entirely and just stay interactive, which is what a resumed
# session looks like.
if [ "${BOARD_RESCUE:-0}" = "1" ]; then
  sleep "${FAKE_MANAGED_HOLD:-60}"
  exit 0
fi

# Spawn registration commits only after readiness polling + agent.prompt return.
# A same-conversation resume hop re-prompts this SAME process on its pane (no
# new agent.start), so when FAKE_PI_LOOP=1 the fixture loops: read one stage's
# prompt, comment, done, then block on the next prompt. Single-stage scenarios
# leave it unset and retain the historical single prompt + bounded hold.
trace=""
if [ "${FAKE_PI_LOOP:-0}" = "1" ]; then
  trace="$(dirname "$BOARD_SOCKET")/fake-pi-loop-$RUN_LABEL.log"
  printf 'pid=%s loop=1 pane=%s record=%s\n' "$$" "${HERDR_PANE_ID:-<unset>}" "$record" >>"$trace"
fi

run_one_pi_stage() {
  [ -z "$trace" ] || printf 'stage: shim start\n' >>"$trace"
  FAKE_MANAGED_KIND=pi \
    python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/managed-terminal-shim.py" "$record" || {
      rc=$?
      if [ -n "$trace" ]; then
        printf 'stage: shim fail rc=%s\n' "$rc" >>"$trace"
        python3 - "$record" >>"$trace" <<'PY' || true
import hashlib, json, sys
try:
    x=json.load(open(sys.argv[1], encoding="utf-8"))
except Exception as e:
    print(f"record_error={type(e).__name__}")
else:
    for key in ("prompt_error", "prompt_received_via_stdin", "prompt_matches_run_snapshot"):
        print(f"{key}={x.get(key)!r}")
    for key in ("prompt", "expected_prompt"):
        value=(x.get(key) or "").encode()
        print(f"{key}_len={len(value)} {key}_sha256={hashlib.sha256(value).hexdigest()}")
PY
      fi
      return "$rc"
    }
  [ -z "$trace" ] || printf 'stage: shim ok\n' >>"$trace"
  sleep "${FAKE_PI_SLEEP:-1.5}"
  "${BOARD_BIN:?BOARD_BIN required}" comment "fake pi: protocol-20 system file and agent.prompt validated" || {
    rc=$?; [ -z "$trace" ] || printf 'stage: comment fail rc=%s\n' "$rc" >>"$trace"; return "$rc"
  }
  [ -z "$trace" ] || printf 'stage: comment ok\n' >>"$trace"
  "$BOARD_BIN" done --outcome ok || {
    rc=$?; [ -z "$trace" ] || printf 'stage: done fail rc=%s\n' "$rc" >>"$trace"; return "$rc"
  }
  [ -z "$trace" ] || printf 'stage: done ok\n' >>"$trace"
}

if [ "${FAKE_PI_LOOP:-0}" = "1" ]; then
  while true; do
    run_one_pi_stage
  done
else
  run_one_pi_stage
  sleep "${FAKE_MANAGED_HOLD:-60}"
fi
